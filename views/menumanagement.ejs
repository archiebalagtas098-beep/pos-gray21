<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Menu Management - Gray Countryside Cafe</title>
    <link rel="stylesheet" href="/menu.css">
</head>
<body>
    <div id="toastContainer"></div>

    <div class="dashboard-container">
        <nav class="navbar">
            <div class="brandname">
                <div class="logo-img"></div>
                <h2>Gray Countryside Cafe</h2>
            </div>
            <div class="logout-container">
                <button onclick="handleLogout()" type="button">Logout</button>
            </div>
        </nav>

        <div class="sidebar">
            <div class="search-section">
                <input type="text" class="search" placeholder="Search.." aria-label="Search menu">
            </div>
            
            <ul class="dashboard-menu">
                <li><a href="/admindashboard/dashboard">Dashboard</a></li>
                <li><a href="/admindashboard/Inventory">Inventory</a></li>
                <li><a href="/admindashboard/salesandreports">Sales Reports</a></li>
                <li><a href="/admindashboard/orderhistory">Order History</a></li>
                <li><a href="/admindashboard/addstaff">Add Staff</a></li>
                <li><a href="/admindashboard/menumanagement" class="active" aria-current="page">Menu Management</a></li>
                <li><a href="/admindashboard/infosettings">Settings</a></li>
            </ul>
            <footer class="sidebar-footer">
                &copy; 2026 For School Purposes Only. All rights reserved.
            </footer>
        </div>

        <div class="main-content">
            <header class="header">
                <div class="logo-section">
                    <h1>Menu Management</h1>
                </div>
            </header>

            <div class="container">
                <aside class="menu-sidebar">
                    <div class="nav-section">
                        <ul class="nav-menu">
                            <li class="nav-item">
                                <a href="#" class="nav-link active" data-section="dashboard" aria-current="page">
                                    <span class="nav-icon">Dashboard</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a href="#" class="nav-link" data-section="menu">
                                    <span class="nav-icon">Product Menu</span>
                                </a>
                                <div class="category-list">
                                    <div class="category-item active" data-category="all" data-fullname="All Products">
                                        All Products
                                        <span class="category-count">0</span>
                                    </div>
                                    <div class="category-item" data-category="Rice" data-fullname="Rice Bowl Meals">
                                        Rice
                                        <span class="category-count">0</span>
                                    </div>
                                    <div class="category-item" data-category="Sizzling" data-fullname="Hot Sizzlers">
                                        Sizzling
                                        <span class="category-count">0</span>
                                    </div>
                                    <div class="category-item" data-category="Party" data-fullname="Party Trays">
                                        Party
                                        <span class="category-count">0</span>
                                    </div>
                                    <div class="category-item" data-category="Drink" data-fullname="Drinks">
                                        Drink
                                        <span class="category-count">0</span>
                                    </div>
                                    <div class="category-item" data-category="Cafe" data-fullname="Coffee">
                                        Cafe
                                        <span class="category-count">0</span>
                                    </div>
                                    <div class="category-item" data-category="Milk" data-fullname="Milk Tea">
                                        Milk
                                        <span class="category-count">0</span>
                                    </div>
                                    <div class="category-item" data-category="Frappe" data-fullname="Frappe">
                                        Frappe
                                        <span class="category-count">0</span>
                                    </div>
                                    <div class="category-item" data-category="Snack & Appetizer" data-fullname="Snacks & Appetizers">
                                        Snack
                                        <span class="category-count">0</span>
                                    </div>
                                    <div class="category-item" data-category="Budget Meals Served with Rice" data-fullname="Budget Meals">
                                        Budget
                                        <span class="category-count">0</span>
                                    </div>
                                    <div class="category-item" data-category="Specialties" data-fullname="Specialties">
                                        Specialty
                                        <span class="category-count">0</span>
                                    </div>
                                    <div class="category-item" data-category="packaging" data-fullname="Packaging">
                                        Packaging
                                        <span class="category-count">0</span>
                                    </div>
                                </div>
                            </li>
                        </ul>
                    </div>
                </aside>

                <main class="inventory-content">
                    <section class="section-content active-section" id="dashboard">
                        <div class="content-header">
                            <div class="content-title">
                                <h2>Menu Dashboard</h2>                 
                            </div>
                        </div>

                        <div class="stats-dashboard">
                            <div class="stat-card">
                                <div class="stat-icon icon-total">Total Products</div>
                                <h3>Total Products</h3>
                                <div class="stat-value" id="totalProducts">0</div>
                                <div class="stat-change">+0 this week</div>
                            </div>
                            <div class="stat-card warning">
                                <div class="stat-icon icon-warning">Low Stock</div>
                                <h3>Low Stock Products</h3>
                                <div class="stat-value" id="lowStock">0</div>
                                <div class="stat-change negative">+0 this week</div>
                            </div>
                            <div class="stat-card critical">
                                <div class="stat-icon icon-critical">Out of Stock</div>
                                <h3>Out of Stock</h3>
                                <div class="stat-value" id="outOfStock">0</div>
                                <div class="stat-change">-0 this week</div>
                            </div>
                            <div class="stat-card">
                                <div class="stat-icon icon-instock">In Stock</div>
                                <h3>In Stock</h3>
                                <div class="stat-value" id="inStock">0</div>
                                <div class="stat-change">+0 this week</div>
                            </div>
                            <div class="stat-card info">
                                <div class="stat-icon icon-value">Menu Value</div>
                                <h3>Menu Value</h3>
                                <div class="stat-value" id="menuValue">₱0</div>
                                <div class="stat-change">+0% this week</div>
                            </div>
                        </div>

                        <div class="inventory-grid" id="dashboardGrid">
                            <div class="empty-state" id="emptyDashboardState" style="display: none;">
                                <div class="empty-state-icon icon-empty">No Products</div>
                                <h3>No Products Available</h3>
                                <p>Add your first menu item to see analytics here</p>
                                <button class="btn btn-primary" id="addFirstItemBtn" type="button">Add First Product</button>
                            </div>
                        </div>
                    </section>

                    <section class="section-content" id="menu">
                        <div class="content-header">
                            <div class="content-title">
                                <h2 id="currentCategoryTitle">Product Menu</h2>
                            </div>
                            <div class="action-buttons">
                                <button class="btn btn-primary" id="addNewItem" type="button">Add New Product</button>
                                <button class="btn btn-success" id="sendStockToStaffBtn" type="button">Send Stock to Staff</button>
                            </div>
                        </div>

                        <div class="inventory-grid" id="menuGrid">
                            <div class="empty-state" id="emptyMenuState" style="display: none;">
                                <div class="empty-state-icon icon-empty">No Products</div>
                                <h3>No Products Available</h3>
                                <p>Get started by adding your first menu item</p>
                                <button class="btn btn-primary" id="addFirstMenuBtn" type="button">Add New Product</button>
                            </div>
                        </div>
                    </section>
                </main>
            </div>
        </div>
    </div>

    <!-- Add/Edit Product Modal -->
    <div class="modal" id="itemModal" role="dialog" aria-modal="true" aria-labelledby="modalTitle" style="display: none;">
        <div class="modal-content">
            <div class="modal-header">
                <h3 id="modalTitle">Add New Product</h3>
                <button class="close-btn" id="closeModal" type="button" aria-label="Close modal">&times;</button>
            </div>
            <form id="itemForm" method="dialog">
                <div class="modal-body">
                    <div class="form-container">
                        <div class="form-grid">
                            <div class="form-group">
                                <label for="itemCategories">Category</label>
                                <select id="itemCategories" class="form-control" required>
                                    <option value="">Select Category</option>
                                    <option value="Rice">Rice Bowl Meals</option>
                                    <option value="Sizzling">Hot Sizzlers</option>
                                    <option value="Party">Party Trays</option>
                                    <option value="Drink">Drinks</option>
                                    <option value="Cafe">Coffee</option>
                                    <option value="Milk">Milk Tea</option>
                                    <option value="Frappe">Frappe</option>
                                    <option value="Snack & Appetizer">Snacks & Appetizers</option>
                                    <option value="Budget Meals Served with Rice">Budget Meals</option>
                                    <option value="Specialties">Specialties</option>
                                    <option value="packaging">Packaging</option>
                                    <option value="others">Others</option>
                                </select>
                            </div>

                            <div class="form-group">
                                <label for="itemName">Product Name</label>
                                <select id="itemName" class="form-control" required>
                                    <option value="">Select Product</option>
                                    <!-- Options remain the same as in original -->
                                </select>
                            </div>
                            
                            <div class="form-group">
                                <label for="itemUnit">Unit</label>
                                <select id="itemUnit" class="form-control" required>
                                    <option value="">Select Unit</option>
                                    <option value="pcs">Pieces</option>
                                    <option value="trays">Trays</option>
                                    <option value="glasses">Glasses</option>
                                    <option value="pitchers">Pitchers</option>
                                    <option value="bottles">Bottles</option>
                                    <option value="cups">Cups</option>
                                    <option value="servings">Servings</option>
                                    <option value="sandwiches">Sandwiches</option>
                                    <option value="meals">Meals</option>
                                    <option value="bowls">Bowls</option>
                                    <option value="pots">Pots</option>
                                    <option value="set">Set</option>
                                    <option value="pack">Pack</option>
                                    <option value="box">Box</option>
                                </select>
                            </div>
                            
                            <div class="form-group stock-field">
                                <label for="currentStock">Current Stock <span class="required">*</span></label>
                                <input type="number" id="currentStock" class="form-control" min="0" step="1" required placeholder="Enter current stock" value="100">
                                <small class="form-hint">Enter the current available quantity</small>
                            </div>
                            
                            <div class="form-group stock-field">
                                <label for="minimumStock">Minimum Stock <span class="required">*</span></label>
                                <input type="number" id="minimumStock" class="form-control" min="0" step="1" required placeholder="Minimum stock" value="20">
                                <small class="form-hint">Alert when stock falls below this level</small>
                            </div>
                            
                            <div class="form-group stock-field">
                                <label for="maximumStock">Maximum Stock <span class="required">*</span></label>
                                <input type="number" id="maximumStock" class="form-control" min="0" step="1" required placeholder="Maximum stock" value="200">
                                <small class="form-hint">Maximum capacity for this item</small>
                            </div>
                            
                            <div class="form-group">
                                <label for="itemPrice">Price (₱) <span class="required">*</span></label>
                                <input type="number" id="itemPrice" class="form-control" min="0" step="0.01" required placeholder="0.00">
                            </div>
                        </div>
                        <input type="hidden" id="itemId">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" id="cancelModalBtn">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="saveItemBtn">Save Product</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Send Stock to Staff Modal -->
    <div class="stock-modal" id="sendStockModal" role="dialog" aria-modal="true" aria-labelledby="sendStockModalTitle" style="display: none;">
        <div class="stock-modal-content">
            <div class="modal-header">
                <h2 id="sendStockModalTitle">Send Stock to Staff</h2>
                <button class="close-modal" id="closeSendStockModal" type="button" aria-label="Close modal">×</button>
            </div>
            
            <div class="modal-body">
                <div class="stock-form-container">
                    <div class="form-row">
                        <div class="form-group">
                            <label for="stockProduct">Select Product</label>
                            <select id="stockProduct" class="form-control" required>
                                <option value="">Select Product to Transfer</option>
                            </select>
                        </div>
                        
                        <div class="form-group">
                            <label for="stockQuantity">Quantity to Transfer <span class="required">*</span></label>
                            <input type="number" id="stockQuantity" class="form-control" min="1" step="1" required placeholder="Enter quantity">
                            <small class="form-hint">Available stock: <span id="availableStock">0</span> units</small>
                        </div>
                    </div>
                    
                    <div class="form-row">
                        <div class="form-group">
                            <label for="transferDate">Transfer Date <span class="required">*</span></label>
                            <input type="date" id="transferDate" class="form-control" required>
                        </div>
                        
                        <div class="form-group full-width">
                            <label for="transferNotes">Additional Notes (Optional)</label>
                            <textarea id="transferNotes" class="form-control" rows="3" placeholder="Enter any additional notes or instructions"></textarea>
                        </div>
                    </div>
                    
                    <div class="form-row">
                        <div class="form-group full-width">
                            <div class="summary-section">
                                <h4>Transfer Summary</h4>
                                <div class="summary-item">
                                    <span>Product:</span>
                                    <span id="summaryProduct">Not selected</span>
                                </div>
                                <div class="summary-item">
                                    <span>Quantity:</span>
                                    <span id="summaryQuantity">0</span>
                                </div>
                                <div class="summary-item">
                                    <span>Date:</span>
                                    <span id="summaryDate">Not selected</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="cancel-btn" id="cancelSendStockBtn">Cancel</button>
                <button type="button" class="confirm-btn" id="confirmSendStockBtn">Confirm Transfer</button>
            </div>
        </div>
    </div>

    <script src="/script/menu.js"></script>
</body>
</html>